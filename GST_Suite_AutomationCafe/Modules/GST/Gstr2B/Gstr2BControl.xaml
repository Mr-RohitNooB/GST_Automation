<UserControl x:Class="GST_Suite_AutomationCafe.Modules.GST.Gstr2B.Gstr2BControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Top cards -->
            <RowDefinition Height="*"/>     <!-- Log -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="#1F2937" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📥" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="GSTR-2B Bulk Downloader" Foreground="White"
                               FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Downloads GSTR-2B Excel for multiple GST portal credentials"
                               Foreground="#9CA3AF" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ TOP CARDS ═══ -->
        <Grid Grid.Row="1" Margin="15,12,15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Credentials Card ── -->
            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="#E5E7EB" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="GST CREDENTIALS" Foreground="#6B7280"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <!-- Credential List -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4"
                            MaxHeight="130" Margin="0,0,0,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CredentialsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               Foreground="#111827"/>
                                                    <TextBlock Text="{Binding Username}"
                                                               FontSize="10" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="✕" Width="22" Height="22"
                                                        FontSize="10" Background="Transparent"
                                                        BorderThickness="0" Foreground="#EF4444"
                                                        Cursor="Hand"
                                                        Tag="{Binding Id}"
                                                        Click="DeleteCredential_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Add Credential Button -->
                    <Button x:Name="ShowAddFormBtn" Content="+ Add Credential"
                            Height="32" Background="#EEF2FF" Foreground="#4F46E5"
                            BorderThickness="1" BorderBrush="#C7D2FE"
                            FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Click="ShowAddFormBtn_Click"/>

                    <!-- Add Credential Form (hidden initially) -->
                    <StackPanel x:Name="AddCredentialForm" Visibility="Collapsed" Margin="0,10,0,0">
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Display Name" FontSize="11"
                                           Foreground="#374151" Margin="0,0,0,3"/>
                                <TextBox x:Name="DisplayNameInput" Height="30"
                                         Padding="8,0" FontSize="12"
                                         BorderBrush="#D1D5DB" BorderThickness="1"
                                         Margin="0,0,0,8"/>

                                <TextBlock Text="GST Username" FontSize="11"
                                           Foreground="#374151" Margin="0,0,0,3"/>
                                <TextBox x:Name="UsernameInput" Height="30"
                                         Padding="8,0" FontSize="12"
                                         BorderBrush="#D1D5DB" BorderThickness="1"
                                         Margin="0,0,0,8"/>

                                <TextBlock Text="GST Password" FontSize="11"
                                           Foreground="#374151" Margin="0,0,0,3"/>
                                <PasswordBox x:Name="PasswordInput" Height="30"
                                             Padding="8,0" FontSize="12"
                                             BorderBrush="#D1D5DB" BorderThickness="1"
                                             Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Width="70" Height="28"
                                            Background="White" Foreground="#6B7280"
                                            BorderBrush="#D1D5DB" BorderThickness="1"
                                            FontSize="11" Cursor="Hand" Margin="0,0,8,0"
                                            Click="CancelAddCredential_Click"/>
                                    <Button Content="Save" Width="70" Height="28"
                                            Background="#4F46E5" Foreground="White"
                                            BorderThickness="0" FontSize="11"
                                            FontWeight="SemiBold" Cursor="Hand"
                                            Click="SaveCredential_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Period Settings Card ── -->
            <Border Grid.Column="2" Background="White" CornerRadius="8"
                    BorderBrush="#E5E7EB" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="PERIOD SETTINGS" Foreground="#6B7280"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Financial Year -->
                    <TextBlock Text="Financial Year" FontSize="12"
                               Foreground="#374151" Margin="0,0,0,4"/>
                    <ComboBox x:Name="YearCombo" Height="32" FontSize="12"
                              BorderBrush="#D1D5DB" Margin="0,0,0,12"/>

                    <!-- All Quarters Toggle -->
                    <CheckBox x:Name="AllQuartersChk" Content="Download All Quarters (Apr–Mar)"
                              FontSize="12" FontWeight="SemiBold" Foreground="#374151"
                              Margin="0,0,0,12" Checked="AllQuarters_Changed"
                              Unchecked="AllQuarters_Changed"/>

                    <!-- Quarter -->
                    <TextBlock Text="Quarter" FontSize="12"
                               Foreground="#374151" Margin="0,0,0,4"/>
                    <ComboBox x:Name="QuarterCombo" Height="32" FontSize="12"
                              BorderBrush="#D1D5DB" Margin="0,0,0,12"
                              SelectionChanged="QuarterCombo_SelectionChanged">
                        <ComboBoxItem Content="Quarter 1 (Apr - Jun)" IsSelected="True"/>
                        <ComboBoxItem Content="Quarter 2 (Jul - Sep)"/>
                        <ComboBoxItem Content="Quarter 3 (Oct - Dec)"/>
                        <ComboBoxItem Content="Quarter 4 (Jan - Mar)"/>
                    </ComboBox>

                    <!-- Month -->
                    <TextBlock Text="Month" FontSize="12"
                               Foreground="#374151" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MonthCombo" Height="32" FontSize="12"
                              BorderBrush="#D1D5DB"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ LOG BOX ═══ -->
        <Border Grid.Row="2" Background="#1F2937" CornerRadius="8"
                Margin="15,12,15,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="EXECUTION LOGS" Foreground="#6B7280"
                           FontSize="10" FontWeight="SemiBold" Margin="12,8,12,4"/>
                <TextBox Grid.Row="1" x:Name="LogBox"
                         Background="Transparent" Foreground="#4ADE80"
                         FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Padding="12,4,12,12"
                         MinHeight="120"/>
            </Grid>
        </Border>

        <!-- ═══ FOOTER ═══ -->
        <StackPanel Grid.Row="3" Margin="15,10,15,15">
            <ProgressBar x:Name="ProgressBar" Height="8" Value="0" Maximum="100"
                         Foreground="#4F46E5" Background="#E5E7EB"
                         BorderThickness="0" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartBtn" Content="▶  START BATCH"
                        Height="42" Width="160"
                        Background="#059669" Foreground="White"
                        BorderThickness="0" FontSize="13" FontWeight="Bold"
                        Cursor="Hand" Margin="0,0,10,0"
                        Click="StartBtn_Click"/>
                <Button x:Name="StopBtn" Content="■  STOP"
                        Height="42" Width="100"
                        Background="#DC2626" Foreground="White"
                        BorderThickness="0" FontSize="13" FontWeight="Bold"
                        Cursor="Hand" IsEnabled="False"
                        Click="StopBtn_Click"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           FontSize="12" Foreground="#6B7280" Margin="15,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ═══ CAPTCHA OVERLAY (hidden until needed) ═══ -->
        <Grid Grid.RowSpan="4" x:Name="CaptchaOverlay" Visibility="Collapsed"
              Background="#AA000000">
            <Border Background="#1F2937" CornerRadius="12" Padding="30"
                    MaxWidth="360" HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#374151" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚠️  CAPTCHA REQUIRED" Foreground="#F87171"
                               FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CaptchaUserLabel" Foreground="#9CA3AF"
                               FontSize="11" HorizontalAlignment="Center"
                               Margin="0,0,0,14"/>

                    <Border BorderBrush="#374151" BorderThickness="1"
                            CornerRadius="6" HorizontalAlignment="Center"
                            Margin="0,0,0,14" Padding="6">
                        <Image x:Name="CaptchaImage" Height="60" Stretch="Uniform"/>
                    </Border>

                    <TextBox x:Name="CaptchaInput"
                             Height="38" FontSize="16" FontFamily="Consolas"
                             TextAlignment="Center" BorderBrush="#4F46E5"
                             BorderThickness="2" Background="#111827"
                             Foreground="White" CaretBrush="White"
                             Margin="0,0,0,14"
                             KeyDown="CaptchaInput_KeyDown"/>

                    <Button Content="SUBMIT CAPTCHA"
                            Height="38" Background="#4F46E5" Foreground="White"
                            BorderThickness="0" FontSize="13" FontWeight="Bold"
                            Cursor="Hand" Click="SubmitCaptcha_Click"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
